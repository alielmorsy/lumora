include_guard(GLOBAL)

# Wraps a vendored library that ships no usable CMake into a target.
#   lumora_add_thirdparty(<name> [ROOT <dir>] [INCLUDE <dir>...] [SOURCES <file>...] [GLOB <pattern>...]
#                         [DEFINES <def>...] [LINK <target>...] [ALIAS <ns::name>])
# With sources the target is STATIC, otherwise INTERFACE. Includes are SYSTEM to keep warnings quiet.
function(lumora_add_thirdparty NAME)
    cmake_parse_arguments(TP "" "ALIAS;ROOT" "INCLUDE;SOURCES;GLOB;DEFINES;LINK" ${ARGN})

    if (NOT TP_ROOT)
        set(TP_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/ThirdParty/${NAME}")
    elseif (NOT IS_ABSOLUTE "${TP_ROOT}")
        set(TP_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/${TP_ROOT}")
    endif ()

    set(_sources "")
    foreach (src IN LISTS TP_SOURCES)
        if (IS_ABSOLUTE "${src}")
            list(APPEND _sources "${src}")
        else ()
            list(APPEND _sources "${TP_ROOT}/${src}")
        endif ()
    endforeach ()
    foreach (pattern IN LISTS TP_GLOB)
        file(GLOB_RECURSE _globbed CONFIGURE_DEPENDS "${TP_ROOT}/${pattern}")
        list(APPEND _sources ${_globbed})
    endforeach ()

    set(_includes "")
    if (NOT TP_INCLUDE)
        list(APPEND _includes "${TP_ROOT}")
    else ()
        foreach (inc IN LISTS TP_INCLUDE)
            if (IS_ABSOLUTE "${inc}")
                list(APPEND _includes "${inc}")
            else ()
                list(APPEND _includes "${TP_ROOT}/${inc}")
            endif ()
        endforeach ()
    endif ()

    if (_sources)
        add_library(${NAME} STATIC ${_sources})
        set(_scope PUBLIC)
    else ()
        add_library(${NAME} INTERFACE)
        set(_scope INTERFACE)
    endif ()

    target_include_directories(${NAME} SYSTEM ${_scope} ${_includes})
    if (TP_DEFINES)
        target_compile_definitions(${NAME} ${_scope} ${TP_DEFINES})
    endif ()
    if (TP_LINK)
        target_link_libraries(${NAME} ${_scope} ${TP_LINK})
    endif ()
    if (TP_ALIAS)
        add_library(${TP_ALIAS} ALIAS ${NAME})
    endif ()
endfunction()
