# cmake -DEXE=... -DBUNDLE=... -DOUT=... -DEXPECT=<exact|contains> -DTEXT=... -P check.cmake
file(REMOVE "${OUT}")
execute_process(COMMAND "${EXE}" --headless-frames 30 --bundle "${BUNDLE}" --dump-text "${OUT}" RESULT_VARIABLE rc)
if (NOT rc EQUAL 0)
    message(FATAL_ERROR "LumoraJsHost exited with ${rc}")
endif ()
if (NOT EXISTS "${OUT}")
    message(FATAL_ERROR "no dump at ${OUT}")
endif ()
file(STRINGS "${OUT}" lines)
if (EXPECT STREQUAL "exact")
    if (NOT lines STREQUAL TEXT)
        message(FATAL_ERROR "dump is '${lines}', expected '${TEXT}'")
    endif ()
else ()
    list(GET lines 0 first)
    string(FIND "${first}" "${TEXT}" at)
    if (at LESS 0)
        message(FATAL_ERROR "first line '${first}' lacks '${TEXT}'")
    endif ()
endif ()
